{
	"name": "akeeba/sociallogin",
	"description": "Akeeba SocialLogin – A social login solution for Joomla!",
	"minimum-stability": "stable",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "Nicholas K. Dionysopoulos",
			"homepage": "https://www.akeeba.com",
			"role": "Lead Developer"
		}
	],
	"config": {
		"platform": {
			"php": "8.1.999"
		}
	},
	"require": {
		"php": ">=8.1 <8.7",
		"ext-json": "*",
		"ext-simplexml": "*",
		"ext-libxml": "*"
	},
	"require-dev": {
		"humbug/php-scoper": "^0.18.7",
		"lcobucci/jwt": "^4.0",
		"codercat/jwk-to-pem": "^1.1",
		"phpseclib/phpseclib": "^3.0.58"
	},
	"extra": {
		"akcompat": {
			"limit_type": "joomla",
			"limit": ">=5.4.0 <6.3",
			"locations": [
				{
					"file": "build/templates/script.sociallogin.php",
					"type": "variable",
					"marker": "$minimumPhp",
					"value": "PHP_MIN"
				},
				{
					"file": "build/templates/script.sociallogin.php",
					"type": "variable",
					"marker": "$maximumPhp",
					"value": "PHP_MAX"
				},
				{
					"file": "build/templates/script.sociallogin.php",
					"type": "variable",
					"marker": "$minimumJoomla",
					"value": "LIMIT_MIN"
				},
				{
					"file": "build/templates/script.sociallogin.php",
					"type": "variable",
					"marker": "$maximumJoomla",
					"value": "LIMIT_MAX"
				}
			]
		}
	},
	"scripts": {
		"scope-dependencies": "@php build/scope-dependencies.php",
		"test": [
			"@test:unit"
		],
		"test:unit": [
			"@composer install --no-interaction --quiet",
			"phpunit"
		]
	}
}
