<project name="AkeebaSocialLogin" description="Akeeba Social Login" default="git" >
	<import file="${phing.dir}/../buildfiles/phing/common.xml" />

	<!-- Fileset for building the package ZIP -->
	<fileset dir="${dirs.release}" id="package">
		<include name="com_*.zip" />
		<include name="mod_*.zip" />
		<include name="plg_*.zip" />
		<include name="lib_*.zip" />
		<include name="pkg_*.xml" />
		<include name="language/**"/>
		<include name="*.txt" />
		<include name="script.sociallogin.php" />
	</fileset>

	<target name="git" description="Makes only packages, not the documentation"
			depends="new-release,setup-properties,compile-javascript,prune-dependencies,component-packages">
	</target>

	<!--
	Post-Mozart pruning of repackaged dependencies.

	Mozart repackages whole Composer packages into plugins/system/sociallogin/src/Dependencies. phpseclib 2.0
	ships ~1.4 MB of SSH/SFTP/X509/cipher code, but the only code we actually use is CoderCat\JWKToPEM which
	needs just Crypt/RSA, Crypt/Hash, Crypt/Random and Math/BigInteger. Remove everything else so it does
	not end up as dead, web-addressable code inside the system plugin package. This must run on every build:
	composer install / update (through Mozart's post-install and post-update hooks) regenerates the
	Dependencies folder.
	-->
	<target name="prune-dependencies" description="Remove unused phpseclib code repackaged by Mozart">
		<delete includeemptydirs="true" failonerror="false" quiet="true">
			<fileset dir="${dirs.root}/plugins/system/sociallogin/src/Dependencies/phpseclib">
				<include name="Net/**" />
				<include name="System/**" />
				<include name="File/**" />
				<include name="Crypt/AES.php" />
				<include name="Crypt/Base.php" />
				<include name="Crypt/Blowfish.php" />
				<include name="Crypt/DES.php" />
				<include name="Crypt/RC2.php" />
				<include name="Crypt/RC4.php" />
				<include name="Crypt/Rijndael.php" />
				<include name="Crypt/TripleDES.php" />
				<include name="Crypt/Twofish.php" />
				<include name="bootstrap.php" />
			</fileset>
		</delete>
	</target>

	<!--
	Internal builder task to process all plugins inside a plugins/whatever folder of your repository, e.g. plugins/system
	-->
	<target name="package-plugin-folder" description="Iterate over the plugins in an area (system, user, ...) directory">
		<property name="plugin_area" value="${dirname}" />

		<foreach param="plugin_name" absparam="plugin_dir" target="package-plugin-item"
				 inheritall="true" inheritrefs="true"
		>
			<fileset dir="${absname}">
				<type type="dir" />
				<depth max="0" min="0" />
			</fileset>
		</foreach>
	</target>

	<target name="compile-javascript" description="Minify JavaScript files">
		<exec executable="node"
		      dir="${dirs.root}/../buildfiles" checkreturn="true" passthru="true">
			<arg value="build-js.mjs" />
			<arg value="${dirs.root}/plugins/system/sociallogin/media/js" />
		</exec>
	</target>
</project>
